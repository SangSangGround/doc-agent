# 문서 AI 안내 프로토타입 환경 변수 예시. 실제 키는 커밋하지 않는다.
# 코드는 .env 파일을 자동으로 읽지 않으므로 PowerShell에서 $env:이름 = "값" 으로 설정한다.

# Gemini 문서 분석·Workflow 생성 (detection/gemini_detection.py, detection/document_workflow_v8.py)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Deepgram 받아쓰기 (detection/workflow_speech_v8.py)
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3

# 선택: STT 비교 진단, RF-DETR 실험
GROQ_API_KEY=
ROBOFLOW_API_KEY=
