# Roboflow RF-DETR 탐지기 설정. 이 파일을 .env 로 복사한 뒤 값을 채운다.
# .env 는 .gitignore 에 등록되어 있어 커밋되지 않는다.
ROBOFLOW_API_KEY=
# (선택) Workflow 에 넘길 모델 id. 비우면 코드 기본값 사용
# ROBOFLOW_MODEL_ID=

# (선택) analyze 실행 기본값. CLI 인자가 이 값보다 우선한다.
# DOCAGENT_DETECTOR_PREFER=roboflow
# DOCAGENT_OCR_KIND=tesseract
# DOCAGENT_OCR_MODE=regions
# DOCAGENT_OCR_LANG=kor+eng
